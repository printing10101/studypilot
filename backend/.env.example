# 复制为 .env 后按需修改
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_API_KEY=none
LLM_MODEL=qwen3-instruct-30b
EMBED_MODEL=BAAI/bge-small-zh-v1.5
EMBED_DEVICE=cuda

# 校园网私有默认值（可选，JSON 对象，键见 backend/app/campus_net.py 的 DEFAULT_CFG）。
# 各校的站点/网段/信息源属个人信息，请只写在本地 .env，不要提交：
# CAMPUS_SEED_JSON={"campus_hosts":["jwc.example.edu.cn"],"internal_hosts":[],"public_cidrs":[],"sources":[{"id":"notice","name":"学校通知","url":"https://www.example.edu.cn/list.htm"}]}
